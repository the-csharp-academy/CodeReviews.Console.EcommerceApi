{
  "info": {
    "name": "Ecommerce API (C# Academy project 18)",
    "description": "All endpoints of the Bean & Barrel ecommerce API. Run the API first (cd EcommerceApi; dotnet run) so it listens on http://localhost:5276, then run this collection top to bottom: the requests are ordered and chain ids through variables. The negative-path requests (400/404/409) render with a red status pill in Postman and are still passing -- the real signal is Failed: 0 / Errors: 0.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5276",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "newCategoryId",
      "value": "0",
      "type": "string"
    },
    {
      "key": "newCategoryName",
      "value": "placeholder",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "0",
      "type": "string"
    },
    {
      "key": "productName",
      "value": "placeholder",
      "type": "string"
    },
    {
      "key": "productStock",
      "value": "0",
      "type": "string"
    },
    {
      "key": "saleId",
      "value": "0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Categories / List all",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const categories = pm.response.json();",
              "pm.test('seeded categories are returned', () => pm.expect(categories.length).to.be.at.least(5));",
              "const coffee = categories.find(c => c.name === 'Coffee');",
              "pm.test('the Coffee category exists', () => pm.expect(coffee).to.not.be.undefined);",
              "pm.test('productCount is present', () => pm.expect(coffee.productCount).to.be.a('number'));",
              "pm.collectionVariables.set('categoryId', coffee.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Categories / Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Category {{$timestamp}}\",\n  \"description\": \"created by the collection\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('has an id', () => pm.expect(body.id).to.be.a('number'));",
              "pm.test('name was stored', () => pm.expect(body.name).to.include('Postman Category'));",
              "pm.collectionVariables.set('newCategoryId', body.id);",
              "pm.collectionVariables.set('newCategoryName', body.name);"
            ]
          }
        }
      ]
    },
