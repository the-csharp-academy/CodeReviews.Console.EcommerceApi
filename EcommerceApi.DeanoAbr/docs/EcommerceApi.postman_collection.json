    {
      "name": "Products / List paged",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?page=1&pageSize=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "5"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('page size is honoured', () => pm.expect(body.items.length).to.be.at.most(5));",
              "pm.test('page metadata is present', () => { pm.expect(body.page).to.eql(1); pm.expect(body.pageSize).to.eql(5); });",
              "pm.test('pagination totals are present', () => { pm.expect(body.totalCount).to.be.above(0); pm.expect(body.totalPages).to.be.at.least(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Products / Filter and sort",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?categoryId={{categoryId}}&minPrice=10&maxPrice=500&sortBy=price&sortDir=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ],
          "query": [
            {
              "key": "categoryId",
              "value": "{{categoryId}}"
            },
            {
              "key": "minPrice",
              "value": "10"
            },
            {
              "key": "maxPrice",
              "value": "500"
            },
            {
              "key": "sortBy",
              "value": "price"
            },
            {
              "key": "sortDir",
              "value": "desc"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const items = pm.response.json().items;",
              "const expectedCategory = Number(pm.collectionVariables.get('categoryId'));",
              "pm.test('every product is in the filtered category', () => items.forEach(p => pm.expect(p.categoryId).to.eql(expectedCategory)));",
              "pm.test('every product is inside the price range', () => items.forEach(p => pm.expect(p.price).to.be.within(10, 500)));",
              "pm.test('prices are sorted descending', () => { const prices = items.map(p => p.price); pm.expect(prices).to.eql([...prices].sort((a, b) => b - a)); });"
            ]
          }
        }
      ]
    },
