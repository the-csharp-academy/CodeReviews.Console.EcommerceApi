      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('total is computed', () => pm.expect(body.total).to.be.above(0));",
              "pm.test('both lines are returned', () => pm.expect(body.items.length).to.eql(2));",
              "pm.test('each line snapshots a unit price', () => body.items.forEach(i => pm.expect(i.unitPrice).to.be.above(0)));",
              "pm.test('lineTotal is quantity x unitPrice', () => body.items.forEach(i => pm.expect(i.lineTotal).to.eql(i.quantity * i.unitPrice)));",
              "pm.collectionVariables.set('saleId', body.id);"
            ]
          }
        }
      ]
