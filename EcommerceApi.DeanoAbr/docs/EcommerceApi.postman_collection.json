            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sales"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Postman Buyer\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    },\n    {\n      \"productId\": 2,\n      \"quantity\": 2\n    }\n  ]\n}",
          "options": {
